[Desktop Entry]
Version=1.0
Type=Application
Name=Install Wi-Fi
Comment=Install Wi-Fi firmware for a 2019 iMac
Terminal=true
StartupNotify=true
Icon=network-wireless
Categories=System;
Exec=bash -c "s=$(find /run/media /media /mnt -maxdepth 5 -name imac19-wifi-install.sh 2>/dev/null | head -1); if [ -z \"$s\" ]; then echo Could not find the installer on the USB stick.; echo Plug the stick in, open Files, and try again.; read; exit 1; fi; exec sudo bash \"$s\""
